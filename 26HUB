local KEY_VALIDE = "KEY-49837887257" -- C'est la clé que tu dois donner aux gens
local FILE_NAME = "26HUB" -- Fichier qui mémorise la clé sur leur appareil

-- Services
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")

-- Variables de position
local savedPosition = nil
local positionSaved = false
local executorName = identifyexecutor and identifyexecutor() or "Unknown"

-- Fonctions utilitaires
local function getGuiParent()
    local success, result = pcall(function()
        return (gethui and gethui()) or CoreGui
    end)
    return success and result or LocalPlayer:WaitForChild("PlayerGui")
end

local function copyToClipboard(text)
    if setclipboard then pcall(setclipboard, text)
    elseif toclipboard then pcall(toclipboard, text)
    elseif set_clipboard then pcall(set_clipboard, text) end
end

-- ==========================================
-- SYSTÈME DE SAUVEGARDE (KEY À VIE)
-- ==========================================
local function hasValidKey()
    if isfile and isfile(FILE_NAME) then
        return readfile(FILE_NAME) == KEY_VALIDE
    end
    return false
end

local function saveKeyLocally()
    if writefile then
        writefile(FILE_NAME, KEY_VALIDE)
    end
end

-- ==========================================
-- INTERFACE DU SYSTÈME DE KEY
-- ==========================================
