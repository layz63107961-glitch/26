local LocalPlayer = Players.LocalPlayer

-- Variables pour stocker la position
local savedPosition = nil
local positionSaved = false

-- Fonction pour obtenir le bon parent pour les GUIs
local function getGuiParent()
    -- Delta préfère CoreGui, Xeno préfère PlayerGui
    local success, result = pcall(function()
        return (gethui and gethui()) or CoreGui
    end)
    
    if success and result then
        return result
    else
        return LocalPlayer:WaitForChild("PlayerGui")
    end
end

-- Fonction pour sauvegarder la position
local function savePosition()
    local character = LocalPlayer.Character
    if not character then
        warn("❌ Personnage introuvable!")
        return false
    end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        warn("❌ HumanoidRootPart introuvable!")
        return false
    end
    
    savedPosition = humanoidRootPart.CFrame
    positionSaved = true
    
    local pos = savedPosition.Position
    print("✅ Position sauvegardée!")
    print(string.format("📍 X: %.2f, Y: %.2f, Z: %.2f", pos.X, pos.Y, pos.Z))
    return true
end

-- Fonction pour se téléporter
local function teleportToPosition()
    if not positionSaved or not savedPosition then
        warn("❌ Aucune position sauvegardée!")
        return false
    end
    
    local character = LocalPlayer.Character
    if not character then
        warn("❌ Personnage introuvable!")
        return false
    end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        warn("❌ HumanoidRootPart introuvable!")
        return false
    end
    
    -- Téléportation sécurisée
    humanoidRootPart.CFrame = savedPosition
    
    local pos = savedPosition.Position
    print("🚀 Téléportation effectuée!")
    print(string.format("📍 X: %.2f, Y: %.2f, Z: %.2f", pos.X, pos.Y, pos.Z))
    return true
end

-- Fonction pour copier dans le presse-papiers (compatible multi-executor)
local function copyToClipboard(text)
    local success = false
    
    -- Essayer setclipboard (Synapse, Xeno, etc.)
    if setclipboard then
        success = pcall(function()
            setclipboard(text)
        end)
    end
    
    -- Essayer toclipboard (Delta)
    if not success and toclipboard then
        success = pcall(function()
            toclipboard(text)
        end)
    end
    
    -- Essayer set_clipboard (Autres executors)
    if not success and set_clipboard then
        success = pcall(function()
            set_clipboard(text)
        end)
    end
    
    return success
end

