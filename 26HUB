    local saveButton = Instance.new("TextButton", mainFrame)
    saveButton.Size = UDim2.new(0, 250, 0, 50)
    saveButton.Position = UDim2.new(0.5, -125, 0, 75)
    saveButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
    saveButton.Text = "💾 SAVE POSITION"
    saveButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    saveButton.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", saveButton)

    local tpButton = Instance.new("TextButton", mainFrame)
    tpButton.Size = UDim2.new(0, 250, 0, 50)
    tpButton.Position = UDim2.new(0.5, -125, 0, 145)
    tpButton.BackgroundColor3 = Color3.fromRGB(200, 0, 200)
    tpButton.Text = "🚀 TP POSITION"
    tpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpButton.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", tpButton)

    -- Logique TP
    saveButton.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            savedPosition = root.CFrame
            positionSaved = true
            saveButton.Text = "✅ SAUVEGARDÉ !"
            wait(1)
            saveButton.Text = "💾 SAVE POSITION"
        end
    end)

    tpButton.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and positionSaved then
            root.CFrame = savedPosition
            tpButton.Text = "✅ TÉLÉPORTÉ !"
            wait(1)
            tpButton.Text = "🚀 TP POSITION"
        else
            tpButton.Text = "❌ AUCUNE SAVE"
            wait(1)
            tpButton.Text = "🚀 TP POSITION"
        end
    end)
end

